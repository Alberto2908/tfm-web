/.angular-cli.json
/.ng/

# TypeScript cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python bytecode (Cursor skill scripts)
__pycache__/
*.pyc
